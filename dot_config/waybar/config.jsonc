{
  "include": [
    "$HOME/.config/waybar/Modules.jsonc",
    "$HOME/.config/waybar/ModulesWorkspaces.jsonc",
    "$HOME/.config/waybar/ModulesCustom.jsonc",
    "$HOME/.config/waybar/ModulesGroups.jsonc"
  ],
  "layer": "top",
  "exclusive": true,
  "passthrough": false,
  "position": "top",
  "spacing": 6,
  "fixed-center": true,
  "margin-top": 3,
  "margin-left": 8,
  "margin-right": 8,
  "modules-left": [
    "custom/separator#cat",
    "custom/separator#dot-line",
    "hyprland/workspaces#rw",
    "custom/separator#dot-line",
    "mpris"
  ],
  "modules-center": [
    "clock#3",
    "custom/pomodoro",
    "custom/separator#dot-line",
    "hyprland/window"
  ],
  "modules-right": [
    "group/laptop",
    "custom/separator#dot-line",
    "group/audio",
    "custom/separator#dot-line",
    "group/notify"
  ]
}
