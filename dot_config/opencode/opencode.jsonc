{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/minimax-m2.7",
  "autoupdate": true,
  "small_model": "opencode-go/minimax-2.5",
  "disabled_providers": ["zen", "codex"],
  "share": "disabled",
  "watcher": {
    "ignore": [
      "**/node_modules/**",
      "**/.git/**",
      "**/dist/**",
      "**/build/**",
      "**/__pycache__/**",
      "**/.venv/**",
      "**/target/**"
    ]
  },
  "plugin": [
    "opencode-env-protect@0.3.0",
    "@mohak34/opencode-notifier@0.1.36",
    "opencode-zellij-namer@1.1.3"
  ],
  "permission": {
    "*": "ask",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "todoread": "allow",
    "todowrite": "allow",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
    },
    "edit": {
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
    },
  },
  "agent": {
    "build": {
      "model": "opencode-go/minimax-m2.7",
    },
    "plan": {
      "model": "opencode-go/minimax-m2.7",
    },
  },
}
